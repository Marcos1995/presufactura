APP_NAME=PresuFactura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Producción recomendado: LOG_STACK=daily LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presufactura
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

ANALYTICS_ENABLED=true
# IPs propias separadas por coma (no se guardan en BD)
ANALYTICS_INTERNAL_IPS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=facturas@presufactura.es
MAIL_PASSWORD="tu_password_entre_comillas_si_tiene_#"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=facturas@presufactura.es
MAIL_FROM_NAME="${APP_NAME}"
# Alternativa con password URL-encoded (útil si #/@ dan problemas):
# MAIL_URL=smtp://facturas%40presufactura.es:PASSWORD_ENCODED@smtp.hostinger.com:587

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Monitorización opcional (requiere: composer require sentry/sentry-laravel)
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"

# Único usuario con catálogo de ejemplo (php artisan presufactura:seed-demo)
DEMO_ADMIN_EMAIL=marcospc1995@gmail.com

# Veri*Factu (SIF / RRSIF) — empezar siempre en preprod; ver docs/VERIFACTU-ENTORNO-PRUEBAS.md
VERIFACTU_ENV=preprod
VERIFACTU_MODE=verifactu
VERIFACTU_SOFTWARE_NIF=
VERIFACTU_SOFTWARE_NAME=PresuFactura
VERIFACTU_SOFTWARE_VERSION=2.0.0
# Test integración AEAT preprod (opcional, php artisan test --group=aeatinternal)
# VERIFACTU_PREPROD_TEST=true
# VERIFACTU_TEST_P12_PATH=
# VERIFACTU_TEST_P12_PASSWORD=
# VERIFACTU_TEST_NIF=
